---
permalink: "sitemap.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in collections.all %}
{% if item.url and item.url != "/404.html" and item.url != "/checkout.html" and item.url != "/sitemap.xml" and item.url != "/blog/feed.xml" %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
{% if item.data.modified or item.data.published %}    <lastmod>{{ item.data.modified or item.data.published }}</lastmod>
{% endif %}  </url>
{% endif %}
{% endfor %}
</urlset>
