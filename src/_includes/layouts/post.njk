---
layout: layouts/blog.njk
bodyClass: no3d page
navCurrent: blog
ogType: article
---
<div class="reading-progress"><div class="reading-progress__bar" id="readBar"></div></div>
<p class="updated">[ FIELD NOTE · {{ category | upper }} ]</p>
<h1>{{ headline or title }}</h1>
<div class="post-meta">
  <time datetime="{{ published }}">{{ published }}</time>
  <span>{{ readingTime }} MIN READ</span>
  <span>BY <a href="/about.html#author" rel="author">{{ site.author.name | upper }}</a></span>
  {% if modified and modified != published %}<span>UPDATED {{ modified }}</span>{% endif %}
</div>
<a class="post-back" href="/blog/">← Field notes</a>

<div class="post-disclosure doc__card">
  <b>What this is.</b> A first-hand engineering note from Joel Ryan's stackwith.me workshop. It documents a real design decision or implementation in this repository; limitations are called out instead of being hidden.
</div>

<!-- AdSense: In-article ad unit goes here after approval.
     Create an in-article ad unit in your AdSense dashboard, then uncomment:
<ins class="adsbygoogle"
     style="display:block; text-align:center;"
     data-ad-layout="in-article"
     data-ad-format="fluid"
     data-ad-client="ca-pub-7262404901375077"
     data-ad-slot="YOUR_SLOT_ID"></ins>
<script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
-->

{{ content | safe }}

<div class="share-bar">
  <button class="share-bar__btn" id="copyLink" type="button">Copy link</button>
  <span class="share-bar__feedback" id="copyFeedback" role="status">Copied</span>
</div>

<div class="post-author-bio">
  <div class="post-author-bio__avatar" aria-hidden="true">JR</div>
  <div class="post-author-bio__body">
    <p class="post-author-bio__name"><a href="/about.html#author" rel="author">Joel Ryan</a></p>
    <p class="post-author-bio__role">Independent builder · stackwith.me</p>
    <p class="post-author-bio__blurb">Joel designs, codes, tests, and documents every project on this domain. He writes about the real implementation decisions behind browser software — including the dead ends, measured limits, and trade-offs that marketing copy usually omits.</p>
    <p class="post-author-bio__links">
      <a href="/about.html">About Joel →</a>
      <a href="/blog/">All field notes →</a>
    </p>
  </div>
</div>

<div class="post-footer">
  <p class="post-related__title">MORE FROM THE WORKBENCH</p>
  <div class="post-related">
  {% set shown = 0 %}
  {% for item in collections.posts | reverse %}
    {% if item.url != page.url and shown < 2 %}
      <a href="{{ item.url }}">
        <span class="post-related__meta">{{ item.data.published }} · {{ item.data.category }}</span>
        <h4>{{ item.data.headline or item.data.title }}</h4>
      </a>
      {% set shown = shown + 1 %}
    {% endif %}
  {% endfor %}
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "stackwith.me", "item": "{{ site.url }}/" },
    { "@type": "ListItem", "position": 2, "name": "Field Notes", "item": "{{ site.url }}/blog/" },
    { "@type": "ListItem", "position": 3, "name": {{ (headline or title) | json | safe }}, "item": "{{ site.url }}{{ page.url }}" }
  ]
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ (headline or title) | json | safe }},
  "description": {{ description | json | safe }},
  "datePublished": "{{ published }}",
  "dateModified": "{{ modified or published }}",
  "author": {
    "@type": "Person",
    "name": "{{ site.author.name }}",
    "url": "{{ site.url }}/about.html#author"
  },
  "publisher": {
    "@type": "Person",
    "name": "{{ site.author.name }}",
    "url": "{{ site.url }}/about.html#author"
  },
  "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
  "image": "{{ site.url }}{{ site.ogImage }}",
  "about": {{ category | json | safe }}
}
</script>
